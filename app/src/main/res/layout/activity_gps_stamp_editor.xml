<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <LinearLayout
        android:id="@+id/editor_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="14dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/editor_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back_arrow" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/gps_camera_title"
            android:textColor="@color/primary_text_color"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/editor_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_btn_keep_phone_tracker"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingTop="9dp"
            android:paddingEnd="18dp"
            android:paddingBottom="9dp"
            android:text="@string/save"
            android:textColor="@color/location_primary_text"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 2. Tabs (Below Header) -->
    <LinearLayout
        android:id="@+id/editor_tabs"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        app:layout_constraintTop_toBottomOf="@id/editor_header">

        <TextView
            android:id="@+id/editor_tab_details"
            style="@style/StampEditorTab"
            android:drawableTop="@drawable/icon_container_detail"
            android:text="@string/tab_details" />

        <TextView
            android:id="@+id/editor_tab_position"
            style="@style/StampEditorTab"
            android:drawableTop="@drawable/ic_editor_position"
            android:text="@string/tab_position" />

        <TextView
            android:id="@+id/editor_tab_map"
            style="@style/StampEditorTab"
            android:drawableTop="@drawable/ic_editor_map"
            android:text="@string/tab_map"
            android:textColor="#67A2FF" />

        <TextView
            android:id="@+id/editor_tab_location"
            style="@style/StampEditorTab"
            android:drawableTop="@drawable/ic_editor_location"
            android:text="@string/tab_location" />

        <TextView
            android:id="@+id/editor_tab_photo"
            style="@style/StampEditorTab"
            android:drawableTop="@drawable/ic_editor_photo2"
            android:text="@string/tab_photo" />
    </LinearLayout>

    <!-- 3. Photo Image (Subtractions Applied: Fits Between Tabs and Bottom) -->
    <ImageView
        android:id="@+id/editor_photo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/captured_photo"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/editor_tabs" />

    <!-- 4. Map Preview Card Overlay -->
    <FrameLayout
        android:id="@+id/editor_map_card"
        android:layout_width="210dp"
        android:layout_height="236dp"
        android:background="@drawable/bg_editor_map_card"
        android:clipToOutline="true"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="@id/editor_photo"
        app:layout_constraintEnd_toEndOf="@id/editor_photo"
        app:layout_constraintStart_toStartOf="@id/editor_photo"
        app:layout_constraintTop_toTopOf="@id/editor_photo">

        <com.google.android.gms.maps.MapView
            android:id="@+id/editor_map_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ImageView
            android:id="@+id/editor_map_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:contentDescription="@string/map_preview"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/editor_map_fallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F2FFFFFF"
            android:gravity="center"
            android:padding="12dp"
            android:text="@string/map_waiting_for_location"
            android:textColor="#25303A"
            android:textSize="12sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 5. Stamp Panel Overlay (Bottom) -->
    <LinearLayout
        android:id="@+id/editor_stamp_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_editor_stamp_panel"
        android:elevation="7dp"
        android:orientation="vertical"
        android:padding="14dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/editor_date"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:background="@drawable/bg_editor_date_chip"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/editor_address"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="3"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/white"
                android:textSize="12sp"  />

            <TextView
                android:id="@+id/editor_weather"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_editor_weather"
                android:gravity="center"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/editor_coordinates"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_editor_coordinates"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:fontFamily="@font/poppins_regular"
            android:textColor="@color/white"
            android:textSize="12sp"  />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout><!--    <FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"-->
