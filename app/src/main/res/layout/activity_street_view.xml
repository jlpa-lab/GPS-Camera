<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/street_view_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/earth_background">

    <LinearLayout
        android:id="@+id/street_view_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/earth_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/street_view_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/street_view_back"
            android:padding="4dp"
            android:src="@drawable/ic_back_nav" />

        <TextView
            android:id="@+id/street_view_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/street_view_title"
            android:textColor="@color/primary_text_color"
            android:textSize="20sp" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/street_view_content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintTop_toBottomOf="@id/street_view_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/street_view_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/street_view_section_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/street_view_title"
                android:textColor="@color/primary_text_color"
                android:textSize="18sp" />

            <FrameLayout
                android:id="@+id/street_view_preview_container"
                android:layout_width="match_parent"
                android:layout_height="280dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_earth_state_card"
                android:clipToOutline="true">

                <LinearLayout
                    android:id="@+id/street_view_drag_hint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:id="@+id/street_view_hint_icon"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_pegman"
                        android:padding="24dp"
                        android:src="@drawable/ic_pegman" />

                    <TextView
                        android:id="@+id/street_view_hint_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="@string/street_view_drag_title"
                        android:textColor="@color/primary_text_color"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/street_view_hint_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:text="@string/street_view_drag_message"
                        android:textColor="@color/secondary_text_color"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/street_view_try_another_road"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/street_view_try_another_road"
                        android:textColor="@color/primary_text_color"
                        android:textSize="16sp"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.gms.maps.StreetViewPanoramaView
                    android:id="@+id/street_view_panorama"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/street_view_panorama_fullscreen"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_earth_view_control"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/street_view_full_screen"
                    android:textColor="@color/primary_text_color"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="12dp"
                    android:elevation="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/street_view_panorama_zoom_in"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_earth_view_control"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/primary_text_color"
                        android:textSize="22sp"
                        android:visibility="gone"
                        android:contentDescription="@string/map_view_zoom_in" />

                    <TextView
                        android:id="@+id/street_view_panorama_zoom_out"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_earth_view_control"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/primary_text_color"
                        android:textSize="22sp"
                        android:visibility="gone"
                        android:contentDescription="@string/map_view_zoom_out" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/street_view_panorama_location"
                    android:layout_width="292dp"
                    android:layout_height="54dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_street_view_location_card"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/street_view_location_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/primary_text_color"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/street_view_location_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/secondary_text_color"
                        android:textSize="14sp" />
                </LinearLayout>
            </FrameLayout>

            <View
                android:id="@+id/street_view_divider"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rounded_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/street_view_map_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/street_view_map"
                    android:textColor="@color/primary_text_color"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/street_view_map_place"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/secondary_text_color"
                    android:textSize="16sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/street_view_map_container"
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_earth_map_result"
                android:clipToOutline="true">

                <com.google.android.gms.maps.MapView
                    android:id="@+id/street_view_aerial_map"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_earth_view_control"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/street_view_coverage"
                    android:textColor="@color/primary_text_color"
                    android:textSize="14sp" />

                <ImageButton
                    android:id="@+id/street_view_map_fullscreen"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_earth_view_control"
                    android:contentDescription="@string/street_view_full_screen"
                    android:padding="9dp"
                    android:src="@drawable/ic_fullscreen" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="14dp"
                    android:elevation="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/street_view_map_zoom_in"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_earth_view_control"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/primary_text_color"
                        android:textSize="22sp"
                        android:contentDescription="@string/map_view_zoom_in" />

                    <TextView
                        android:id="@+id/street_view_map_zoom_out"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_earth_view_control"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/primary_text_color"
                        android:textSize="22sp"
                        android:contentDescription="@string/map_view_zoom_out" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/street_view_pegman"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_pegman"
                    android:clickable="true"
                    android:contentDescription="@string/street_view_pegman"
                    android:elevation="8dp"
                    android:padding="7dp"
                    android:src="@drawable/ic_pegman" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
