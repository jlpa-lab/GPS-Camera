<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/street_view_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <LinearLayout
        android:id="@+id/street_view_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/screen_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/street_view_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/street_view_back"
            android:src="@drawable/ic_back_nav" />

        <TextView
            android:id="@+id/street_view_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/street_view_title"
            android:textColor="@color/location_primary_text"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/street_view_search_icon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginVertical="4dp"
            android:background="@drawable/bg_earth_view_control"
            android:contentDescription="@string/earth_view_search"
            android:src="@drawable/ic_search"
            app:tint="@color/home_accent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/street_view_search_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:elevation="12dp"
        android:orientation="vertical"
        android:translationZ="12dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/street_view_header">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_earth_search"
            android:elevation="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/street_view_search_button"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/earth_view_search"
                android:padding="0dp"
                android:src="@drawable/ic_search"
                app:tint="@color/home_accent" />

            <EditText
                android:id="@+id/street_view_search_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="44dp"
                android:background="@null"
                android:fontFamily="@font/poppins_regular"
                android:hint="@string/earth_view_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/primary_text_color"
                android:textColorHint="@color/secondary_text_color"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/street_view_clear_search"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical|end"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/earth_view_clear_search"
                android:padding="2dp"
                android:src="@drawable/ic_close"
                android:visibility="gone" />
        </FrameLayout>

        <include
            layout="@layout/layout_native_all"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginTop="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/street_view_search_results"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_earth_place_card"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:padding="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/street_view_content_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/street_view_header">

        <LinearLayout
            android:id="@+id/street_view_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="28dp"
            android:weightSum="10">

            <TextView
                android:id="@+id/street_view_section_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="20dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/street_view_title"
                android:textColor="@color/primary_text_color"
                android:textSize="14sp" />

            <FrameLayout
                android:id="@+id/street_view_preview_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:layout_weight="5"
                android:background="@drawable/bg_earth_state_card"
                android:clipToOutline="true">

                <LinearLayout
                    android:id="@+id/street_view_drag_hint"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp">

                    <ImageView
                        android:id="@+id/street_view_hint_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_pegman_illustration" />

                    <TextView
                        android:id="@+id/street_view_hint_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="@string/street_view_drag_title"
                        android:textColor="@color/primary_text_color"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/street_view_hint_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:text="@string/street_view_drag_message"
                        android:textColor="@color/color_rate_description_text"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/street_view_try_another_road"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:paddingStart="20dp"
                        android:paddingEnd="20dp"
                        android:text="@string/street_view_try_another_road"
                        android:textColor="@color/primary_text_color"
                        android:textSize="16sp"
                        android:visibility="gone" />
                </LinearLayout>

                <com.google.android.gms.maps.StreetViewPanoramaView
                    android:id="@+id/street_view_panorama"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/street_view_static_panorama"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/street_view_title"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/street_view_panorama_fullscreen"
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_earth_view_control"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/street_view_full_screen"
                    android:textColor="@color/primary_text_color"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/street_view_panorama_location"
                    android:layout_width="292dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="12dp"
                    android:background="@drawable/bg_street_view_location_card"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/street_view_location_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/primary_text_color"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/street_view_location_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="5dp"
                        android:fontFamily="@font/poppins_regular"
                        android:textColor="@color/secondary_text_color"
                        android:textSize="11sp" />
                </LinearLayout>
            </FrameLayout>

            <View
                android:id="@+id/street_view_divider"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/rounded_divider" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/street_view_map_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/street_view_map"
                    android:textColor="@color/primary_text_color"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/street_view_map_place"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/color_rate_description_text"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/street_view_map_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:layout_weight="5"
                android:background="@drawable/bg_earth_map_result"
                android:clipToOutline="true">

                <com.google.android.gms.maps.MapView
                    android:id="@+id/street_view_aerial_map"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <WebView
                    android:id="@+id/street_view_coverage_web_map"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="30dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="10dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_earth_view_control"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/street_view_coverage"
                    android:textColor="@color/color_rate_title_text"
                    android:textSize="12sp" />

                <ImageButton
                    android:id="@+id/street_view_map_fullscreen"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_earth_view_control"
                    android:contentDescription="@string/street_view_full_screen"
                    android:padding="9dp"
                    android:src="@drawable/ic_fullscreen" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="14dp"
                    android:elevation="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/street_view_map_zoom_in"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_earth_view_control"
                        android:clickable="true"
                        android:contentDescription="@string/map_view_zoom_in"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/primary_text_color"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/street_view_map_zoom_out"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/bg_earth_view_control"
                        android:clickable="true"
                        android:contentDescription="@string/map_view_zoom_out"
                        android:focusable="true"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:text="−"
                        android:textColor="@color/primary_text_color"
                        android:textSize="22sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/street_view_pegman"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:layout_marginEnd="14dp"
                    android:layout_marginBottom="14dp"
                    android:clickable="true"
                    android:contentDescription="@string/street_view_pegman"
                    android:elevation="12dp"
                    android:src="@drawable/ic_pegman_illustration" />

                <ImageView
                    android:id="@+id/street_view_map_location_pegman"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:clickable="false"
                    android:contentDescription="@string/street_view_pegman"
                    android:elevation="13dp"
                    android:focusable="false"
                    android:src="@drawable/ic_pegman_illustration"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
