<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/earth_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/area_measurement_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/earth_background"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/area_measurement_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/area_measurement_back"
            android:padding="4dp"
            android:src="@drawable/ic_back_nav" />

        <TextView
            android:id="@+id/area_measurement_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/tool_area_measurement"
            android:textColor="@color/primary_text_color"
            android:textSize="20sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/area_measurement_map_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:layout_weight="1"
        android:background="@drawable/bg_earth_map_result"
        android:clipToOutline="true">

        <com.google.android.gms.maps.MapView
            android:id="@+id/area_measurement_map"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/area_measurement_map_fallback"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_area_measurement_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/area_measurement_invalid_icon"
                android:src="@drawable/ic_area_measurement_warning"
                android:tint="@color/home_accent" />

            <TextView
                android:id="@+id/area_measurement_invalid_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/area_measurement_invalid_title"
                android:textColor="@color/primary_text_color"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/area_measurement_invalid_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:text="@string/area_measurement_invalid_message"
                android:textColor="@color/secondary_text_color"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/area_measurement_map_unavailable"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/earth_background"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/area_measurement_map_unavailable"
            android:textColor="@color/secondary_text_color"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/area_measurement_empty_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <TextView
            android:id="@+id/area_measurement_instruction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/area_measurement_instruction"
            android:textColor="@color/primary_text_color"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/area_measurement_action"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_area_measurement_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="@string/area_measurement_start"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/area_measurement_editing_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_area_measurement_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/area_measurement_boundary_points"
                android:textColor="@color/primary_text_color"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/area_measurement_points_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/home_accent"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/area_measurement_undo"
                style="@style/AreaMeasurementSecondaryAction"
                android:text="@string/area_measurement_undo" />

            <TextView
                android:id="@+id/area_measurement_reset"
                style="@style/AreaMeasurementSecondaryAction"
                android:text="@string/area_measurement_reset" />

            <TextView
                android:id="@+id/area_measurement_unit"
                style="@style/AreaMeasurementSecondaryAction"
                android:text="@string/area_measurement_units" />
        </LinearLayout>

        <TextView
            android:id="@+id/area_measurement_finish"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_area_measurement_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="@string/area_measurement_finish"
            android:textColor="@color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/area_measurement_result_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp"
        android:visibility="gone">

        <include
            android:id="@+id/area_measurement_area_card"
            layout="@layout/view_area_measurement_value_card"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <include
            android:id="@+id/area_measurement_perimeter_card"
            layout="@layout/view_area_measurement_value_card"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/area_measurement_again"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_area_measurement_button"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/poppins_semibold"
            android:gravity="center"
            android:text="@string/area_measurement_again"
            android:textColor="@color/white"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/area_measurement_result_back"
            style="@style/AreaMeasurementBackAction"
            android:layout_marginTop="12dp"
            android:text="@string/area_measurement_back_to_tools" />
    </LinearLayout>

    <TextView
        android:id="@+id/area_measurement_invalid_action"
        style="@style/AreaMeasurementInvalidAction"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="40dp"
        android:text="@string/area_measurement_edit_boundary"
        android:visibility="gone" />

    <TextView
        android:id="@+id/area_measurement_invalid_back"
        style="@style/AreaMeasurementBackAction"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="40dp"
        android:text="@string/area_measurement_back_to_tools"
        android:visibility="gone" />

</LinearLayout>
