<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_background">

    <LinearLayout
        android:id="@+id/gallery_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/gallery_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/gallery_back"
            android:padding="0dp"
            android:src="@drawable/ic_back_nav" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/gallery_title"
            android:textColor="@color/primary_text_color"
            android:textSize="18sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/gallery_state_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/gallery_header">

        <LinearLayout
            android:id="@+id/gallery_captures_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:id="@+id/gallery_filters"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/gallery_filter_all"
                    style="@style/GalleryFilterChip"
                    android:text="@string/gallery_all" />

                <TextView
                    android:id="@+id/gallery_filter_photos"
                    style="@style/GalleryFilterChip"
                    android:layout_marginStart="8dp"
                    android:text="@string/gallery_photos" />

                <TextView
                    android:id="@+id/gallery_filter_videos"
                    style="@style/GalleryFilterChip"
                    android:layout_marginStart="8dp"
                    android:text="@string/gallery_videos" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/gallery_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="0dp"
                android:overScrollMode="never" />

            <TextView
                android:id="@+id/gallery_permission_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:text="@string/gallery_captures_permission"
                android:textColor="@color/secondary_text_color"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/gallery_permission_button"
                style="@style/GalleryTextButton"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:layout_marginBottom="12dp"
                android:text="@string/gallery_open_settings"
                android:visibility="gone" />

            <TextView
                android:id="@+id/gallery_take_photo"
                style="@style/GalleryPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="24dp"
                android:text="@string/gallery_take_photo" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/gallery_details_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <FrameLayout
                    android:id="@+id/gallery_detail_media_frame"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:background="@drawable/bg_gallery_photo"
                    android:clipToOutline="true"
                    android:outlineProvider="background">

                    <ImageView
                        android:id="@+id/gallery_detail_image"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop" />

                    <ImageButton
                        android:id="@+id/gallery_detail_play"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_gallery_duration"
                        android:padding="14dp"
                        android:src="@drawable/ic_play"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/gallery_stamp_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_margin="16dp"
                        android:background="@drawable/bg_gallery_stamp_card"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/gallery_stamp_place"
                            style="@style/GalleryStampText"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/gallery_stamp_coordinates"
                            style="@style/GalleryStampText" />

                        <TextView
                            android:id="@+id/gallery_stamp_date"
                            style="@style/GalleryStampText" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/gallery_detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/primary_text_color"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/gallery_detail_date"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/poppins_regular"
                    android:textColor="@color/secondary_text_color"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/gallery_share"
                    style="@style/GalleryPrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/gallery_delete"
                    style="@style/GalleryDeleteTextButton"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/gallery_delete_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp">

                <ImageView
                    android:id="@+id/gallery_delete_preview"
                    android:layout_width="match_parent"
                    android:layout_height="320dp"
                    android:background="@drawable/bg_gallery_photo"
                    android:clipToOutline="true"
                    android:outlineProvider="background"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_photo_grid_panel"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_gallery_warning" />

                    <TextView
                        android:id="@+id/gallery_delete_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:textColor="@color/primary_text_color"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/gallery_delete_warning"
                        android:textColor="@color/secondary_text_color"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/gallery_confirm_delete"
                    style="@style/GalleryDeleteButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:id="@+id/gallery_keep"
                    style="@style/GallerySecondaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </ScrollView>

        <ScrollView
            android:id="@+id/gallery_empty_state"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <LinearLayout
                    android:id="@+id/gallery_empty_card"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_photo_grid_panel"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <ImageView
                        android:id="@+id/gallery_empty_icon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/ic_gallery_empty" />

                    <TextView
                        android:id="@+id/gallery_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center"
                        android:textColor="@color/primary_text_color"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/gallery_empty_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:fontFamily="@font/poppins_regular"
                        android:gravity="center"
                        android:textColor="@color/secondary_text_color"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/gallery_permission_action"
                        style="@style/GalleryTextButton"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:layout_marginTop="16dp"
                        android:text="@string/gallery_open_settings"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/gallery_empty_take_photo"
                    style="@style/GalleryPrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/gallery_take_photo" />

                <TextView
                    android:id="@+id/gallery_back_tools"
                    style="@style/GalleryTextButton"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    android:text="@string/gallery_back_to_tools" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
