<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="42dp"
        android:paddingEnd="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/tools_title"
            android:textColor="@color/primary_text_color"
            android:includeFontPadding="false"
            android:textSize="24sp" />

        <LinearLayout
            android:id="@+id/tools_list_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_tools_panel"
            android:clipToOutline="true"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/tool_gallery"
                style="@style/ToolsListRow">
                <ImageView
                    style="@style/ToolsListIcon"
                    android:contentDescription="@string/gallery_title"
                    android:src="@drawable/ic_tool_gallery" />
                <TextView
                    style="@style/ToolsListLabel"
                    android:text="@string/gallery_title" />
                <ImageView
                    style="@style/ToolsListArrow"
                    android:contentDescription="@string/open" />
            </LinearLayout>

            <View style="@style/ToolsListDivider" />

            <LinearLayout
                android:id="@+id/tool_photo_grid"
                style="@style/ToolsListRow">
                <ImageView
                    style="@style/ToolsListIcon"
                    android:contentDescription="@string/photo_grid_title"
                    android:src="@drawable/ic_tool_photo_grid" />
                <TextView
                    style="@style/ToolsListLabel"
                    android:text="@string/photo_grid_title" />
                <ImageView
                    style="@style/ToolsListArrow"
                    android:contentDescription="@string/open" />
            </LinearLayout>

            <View style="@style/ToolsListDivider" />

            <LinearLayout
                android:id="@+id/tool_template"
                style="@style/ToolsListRow">
                <ImageView
                    style="@style/ToolsListIcon"
                    android:contentDescription="@string/tools_templates"
                    android:src="@drawable/ic_tool_template" />
                <TextView
                    style="@style/ToolsListLabel"
                    android:text="@string/tools_templates" />
                <ImageView
                    style="@style/ToolsListArrow"
                    android:contentDescription="@string/open" />
            </LinearLayout>

            <View style="@style/ToolsListDivider" />

            <LinearLayout
                android:id="@+id/tool_camera"
                style="@style/ToolsListRow">
                <ImageView
                    style="@style/ToolsListIcon"
                    android:contentDescription="@string/tools_gps_camera"
                    android:src="@drawable/ic_tool_camera" />
                <TextView
                    style="@style/ToolsListLabel"
                    android:text="@string/tools_gps_camera" />
                <ImageView
                    style="@style/ToolsListArrow"
                    android:contentDescription="@string/open" />
            </LinearLayout>

            <View style="@style/ToolsListDivider" />

            <LinearLayout
                android:id="@+id/tool_video"
                style="@style/ToolsListRow">
                <ImageView
                    style="@style/ToolsListIcon"
                    android:contentDescription="@string/tools_gps_video"
                    android:src="@drawable/ic_tool_video" />
                <TextView
                    style="@style/ToolsListLabel"
                    android:text="@string/tools_gps_video" />
                <ImageView
                    style="@style/ToolsListArrow"
                    android:contentDescription="@string/open" />
            </LinearLayout>

            <View style="@style/ToolsListDivider" />

            <LinearLayout
                android:id="@+id/tool_area_measurement"
                style="@style/ToolsListRow">
                <ImageView
                    style="@style/ToolsListIcon"
                    android:contentDescription="@string/tools_area_measurement"
                    android:src="@drawable/ic_tool_area" />
                <TextView
                    style="@style/ToolsListLabel"
                    android:text="@string/tools_area_measurement" />
                <ImageView
                    style="@style/ToolsListArrow"
                    android:contentDescription="@string/open" />
            </LinearLayout>

            <View style="@style/ToolsListDivider" />

            <LinearLayout
                android:id="@+id/tool_route_plan"
                style="@style/ToolsListRow">
                <ImageView
                    style="@style/ToolsListIcon"
                    android:contentDescription="@string/route_plan_title"
                    android:src="@drawable/ic_tool_route" />
                <TextView
                    style="@style/ToolsListLabel"
                    android:text="@string/route_plan_title" />
                <ImageView
                    style="@style/ToolsListArrow"
                    android:contentDescription="@string/open" />
            </LinearLayout>

            <View style="@style/ToolsListDivider" />

            <LinearLayout
                android:id="@+id/tool_location"
                style="@style/ToolsListRow">
                <ImageView
                    style="@style/ToolsListIcon"
                    android:contentDescription="@string/location_title"
                    android:src="@drawable/ic_tool_location" />
                <TextView
                    style="@style/ToolsListLabel"
                    android:text="@string/location_title" />
                <ImageView
                    style="@style/ToolsListArrow"
                    android:contentDescription="@string/open" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
