<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_feature_card"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:background="@drawable/bg_home_card"
    android:clickable="true"
    android:clipToOutline="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/home_feature_icon"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="13dp"
        android:layout_marginTop="13dp"
        android:background="@drawable/bg_home_icon_tile_blue"
        android:contentDescription="@null"
        android:padding="8dp"
        android:src="@drawable/ic_globe" />

    <ImageView
        android:id="@+id/home_feature_arrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="13dp"
        android:layout_marginEnd="13dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrow_right"
        android:tint="#9DBBFF" />

    <TextView
        android:id="@+id/home_feature_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="13dp"
        android:layout_marginBottom="13dp"
        android:fontFamily="@font/poppins_semibold"
        android:includeFontPadding="false"
        android:text="Earth View"
        android:textColor="#F4F6FF"
        android:textSize="14sp" />
</FrameLayout>
