<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/earth_view_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/earth_background">

    <com.gps.map.camera.and.time.stamp.ui.earthview.EarthWorldWindow
        android:id="@+id/earth_map_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/earth_view_header_overlay"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/earth_background"
        android:elevation="4dp"
        android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/earth_view_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/earth_view_back"
            android:padding="2dp"
            android:src="@drawable/ic_back_nav" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/earth_view_title"
            android:textColor="@color/primary_text_color"
            android:textSize="24sp" />
    </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/earth_view_search_overlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_earth_search"
            android:elevation="8dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/earth_view_search_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/earth_view_search"
                android:padding="0dp"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/earth_view_search_input"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="44dp"
                android:background="@null"
                android:fontFamily="@font/poppins_regular"
                android:hint="@string/earth_view_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="textCapSentences"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/primary_text_color"
                android:textColorHint="@color/secondary_text_color"
                android:textSize="18sp" />

            <ProgressBar
                android:id="@+id/earth_view_search_progress"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center_vertical|end"
                android:indeterminateTint="@color/home_accent"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/earth_view_clear_search"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical|end"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/earth_view_clear_search"
                android:padding="2dp"
                android:src="@drawable/ic_close"
                android:visibility="gone" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/earth_view_search_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_earth_results"
            android:clipToPadding="false"
            android:elevation="8dp"
            android:minHeight="48dp"
            android:overScrollMode="never"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/earth_view_my_location"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/earth_view_my_location"
        android:elevation="8dp"
        android:padding="8dp"
        android:src="@drawable/ic_my_location" />

</FrameLayout>
