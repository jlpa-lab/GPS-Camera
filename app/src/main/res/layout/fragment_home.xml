                    <TextView
                        android:layout_width="25dp"
                        android:layout_height="25dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_home_pin"
                        android:elevation="8dp"
                        android:gravity="center"
                        android:text="●"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:translationY="-18dp" />
                </FrameLayout>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="9dp"
            android:fontFamily="sans-serif-medium"
            android:text="Explore"
            android:textColor="#F6F7FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/card_earth_view"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_earth_gradient"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <!--  Add the Figma vector drawable ic_earth_view to this ImageView.  -->
                <ImageView
                    android:id="@+id/home_icon_earth_view"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="13dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/ic_globe"
                    android:contentDescription="Earth View icon"
                    android:padding="9dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="13dp"
                    android:layout_marginEnd="14dp"
                    android:text="→"
                    android:textColor="#9DBBFF"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="13dp"
                    android:layout_marginBottom="13dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Earth View"
                    android:textColor="#F4F6FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/card_street_view"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_street_gradient"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <!--  Add the Figma vector drawable ic_street_view to this ImageView.  -->
                <ImageView
                    android:id="@+id/home_icon_street_view"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="13dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/ic_street"
                    android:contentDescription="Street View icon"
                    android:padding="9dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="13dp"
                    android:layout_marginEnd="14dp"
                    android:text="→"
                    android:textColor="#F3A6D8"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="13dp"
                    android:layout_marginBottom="13dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Street View"
                    android:textColor="#F4F6FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/card_live_video"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_live_gradient"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <!--  Add the Figma vector drawable ic_live_video to this ImageView.  -->
                <ImageView
                    android:id="@+id/home_icon_live_video"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="13dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/ic_video"
                    android:contentDescription="Live Video icon"
                    android:padding="9dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="13dp"
                    android:layout_marginEnd="14dp"
                    android:text="→"
                    android:textColor="#F4A7C8"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="13dp"
                    android:layout_marginBottom="13dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Live Video"
                    android:textColor="#F4F6FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/card_map_view"
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_home_map_gradient"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">
                <!--  Add the Figma vector drawable ic_map_view to this ImageView.  -->
                <ImageView
                    android:id="@+id/home_icon_map_view"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="13dp"
                    android:layout_marginTop="13dp"
                    android:background="@drawable/ic_map"
                    android:contentDescription="Map View icon"
                    android:padding="9dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_marginTop="13dp"
                    android:layout_marginEnd="14dp"
                    android:text="→"
                    android:textColor="#78D8CB"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|start"
                    android:layout_marginStart="13dp"
                    android:layout_marginBottom="13dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Map View"
                    android:textColor="#F4F6FF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>