<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/earth_background"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/location_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/earth_background"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <ImageButton
            android:id="@+id/location_back"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/location_back"
            android:padding="4dp"
            android:src="@drawable/ic_back_nav" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/location_title"
            android:textColor="@color/primary_text_color"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/location_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/location_map_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_area_measurement_card"
            android:clipToOutline="true">

            <com.google.android.gms.maps.MapView
                android:id="@+id/location_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/location_map_unavailable"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/earth_background"
                android:gravity="center"
                android:padding="24dp"
                android:text="@string/location_map_unavailable"
                android:textColor="@color/secondary_text_color"
                android:textSize="15sp"
                android:visibility="gone" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/location_loading_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp">

            <TextView
                android:id="@+id/location_loading_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/location_finding"
                android:textColor="@color/primary_text_color"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/location_loading_search"
                style="@style/LocationOutlineButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="@string/location_search_manually" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/location_found_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="40dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/location_found_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/primary_text_color"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/location_latitude_row"
                style="@style/LocationInfoCard"
                android:layout_marginTop="20dp">

                <TextView
                    style="@style/LocationInfoLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/location_latitude" />

                <TextView
                    android:id="@+id/location_latitude_value"
                    style="@style/LocationInfoValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/location_longitude_row"
                style="@style/LocationInfoCard"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/LocationInfoLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/location_longitude" />

                <TextView
                    android:id="@+id/location_longitude_value"
                    style="@style/LocationInfoValue" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/location_accuracy_row"
                style="@style/LocationInfoCard"
                android:layout_marginTop="12dp">

                <TextView
                    style="@style/LocationInfoLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/location_accuracy" />

                <TextView
                    android:id="@+id/location_accuracy_value"
                    style="@style/LocationInfoValue" />
            </LinearLayout>

            <TextView
                android:id="@+id/location_share"
                style="@style/LocationPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/location_share" />

            <TextView
                android:id="@+id/location_search_another"
                style="@style/LocationOutlineButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:text="@string/location_search_another" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/location_search_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_area_measurement_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/location_search_label"
                    android:textColor="@color/primary_text_color"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/location_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center_vertical|end"
                    android:hint="@string/location_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="textCapSentences"
                    android:maxLines="1"
                    android:padding="0dp"
                    android:textColor="@color/home_accent"
                    android:textColorHint="@color/home_accent"
                    android:textSize="16sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/location_search_progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:indeterminateTint="@color/home_accent"
                android:visibility="gone" />

            <TextView
                android:id="@+id/location_search_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:text="@string/location_no_places"
                android:textColor="@color/secondary_text_color"
                android:textSize="15sp"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/location_search_results"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:overScrollMode="never" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/location_unavailable_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingBottom="40dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:layout_marginBottom="20dp"
                android:layout_weight="1"
                android:background="@drawable/bg_area_measurement_card"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/location_unavailable_icon"
                    android:src="@drawable/ic_area_measurement_warning"
                    android:tint="@color/home_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/location_unavailable_title"
                    android:textColor="@color/primary_text_color"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:text="@string/location_unavailable_message"
                    android:textColor="@color/secondary_text_color"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/location_try_again"
                style="@style/LocationPrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:text="@string/location_try_again" />

            <TextView
                android:id="@+id/location_unavailable_search"
                style="@style/LocationOutlineButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="20dp"
                android:text="@string/location_search_manually" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
