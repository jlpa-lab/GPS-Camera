<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="42dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center_vertical"
            android:includeFontPadding="false"
            android:text="@string/widget_title"
            android:textColor="@color/primary_text_color"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:id="@+id/widget_cards">

        <FrameLayout
            android:id="@+id/widget_live_gps_card"
            android:layout_width="match_parent"
            android:layout_height="208dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_widget_live_card"
            android:clickable="true"
            android:clipToOutline="true"
            android:focusable="true"
            android:foreground="?android:attr/selectableItemBackground">

            <ImageView
                android:id="@+id/widget_map_fallback"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/widget_location_preview"
                android:scaleType="centerCrop"
                android:src="@drawable/home_map_view" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="14dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_widget_live_label"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="18dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="15dp"
                    android:contentDescription="@string/widget_live_gps"
                    android:src="@drawable/ic_tool_location"
                    app:tint="#86E8D4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/widget_live_gps"
                    android:textColor="@color/primary_text_color"
                    android:textSize="12sp" />
            </LinearLayout>

            <FrameLayout
                android:id="@+id/widget_current_location_marker"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_widget_location_marker"
                android:elevation="4dp"
                android:padding="14dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/widget_my_location"
                    android:src="@drawable/ic_location_pin_white" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_gravity="bottom"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="15dp"
                android:background="@drawable/bg_widget_live_footer"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center_vertical"
                    android:text="@string/widget_my_location"
                    android:textColor="@color/primary_text_color"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center_vertical|end"
                    android:contentDescription="@string/widget_my_location"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="#A9CCFF" />
            </FrameLayout>
        </FrameLayout>
    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="225dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/widget_world_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_world_card"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:contentDescription="@string/widget_world_view"
                    android:scaleType="fitCenter"
                    android:padding="10dp"
                    android:src="@drawable/ic_globe_artwork" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:background="@drawable/bg_widget_world_footer"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center_vertical"
                        android:text="@string/widget_world_view"
                        android:textColor="@color/primary_text_color"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical|end"
                        android:contentDescription="@string/widget_world_view"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#A9CCFF" />
                </FrameLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/widget_trending_card"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_widget_trending_card"
                android:clickable="true"
                android:clipToOutline="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="160dp"
                    android:contentDescription="@string/widget_trending_view"
                    android:scaleType="centerCrop"
                    android:src="@drawable/home_street_view" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:background="@drawable/bg_widget_trending_footer"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:fontFamily="@font/poppins_semibold"
                        android:gravity="center_vertical"
                        android:text="@string/widget_trending_view"
                        android:textColor="@color/primary_text_color"
                        android:textSize="14sp" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center_vertical|end"
                        android:contentDescription="@string/widget_trending_view"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#A9CCFF" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
