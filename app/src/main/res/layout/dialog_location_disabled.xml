<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_location_disabled_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="28dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp">

    <TextView
        android:id="@+id/location_dialog_icon"
        android:layout_width="wrap_content"
        android:layout_height="80dp"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="🗺️"
        android:textSize="68sp" />

    <TextView
        android:id="@+id/location_dialog_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/location_disabled_dialog_title"
        android:textColor="@color/primary_text_color"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/location_dialog_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="5dp"
        android:text="@string/location_disabled_dialog_message"
        android:textColor="@color/secondary_text_color"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/location_dialog_turn_on"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_location_dialog_primary"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/location_disabled_dialog_turn_on"
        android:textColor="@color/white"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/location_dialog_not_now"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="4dp"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="@string/location_disabled_dialog_not_now"
        android:textColor="#D0DDEC"
        android:textSize="16sp" />
</LinearLayout>
