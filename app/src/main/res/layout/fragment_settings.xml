<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="34dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_semibold"
            android:text="@string/settings_title"
            android:textColor="@color/primary_text_color"
            android:textSize="24sp" />

        <LinearLayout
            android:id="@+id/settings_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_settings_card"
            android:clipToOutline="true"
            android:orientation="vertical">

            <include android:id="@+id/settings_row_appearance" layout="@layout/item_settings_row" />
            <include android:id="@+id/settings_row_language" layout="@layout/item_settings_row" />
            <include android:id="@+id/settings_row_units" layout="@layout/item_settings_row" />
            <include android:id="@+id/settings_row_stamp" layout="@layout/item_settings_row" />
            <include android:id="@+id/settings_row_permissions" layout="@layout/item_settings_row" />
            <include android:id="@+id/settings_row_rate" layout="@layout/item_settings_row" />
            <include android:id="@+id/settings_row_privacy" layout="@layout/item_settings_row" />
            <include android:id="@+id/settings_row_terms" layout="@layout/item_settings_row" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/settings_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center"
            android:textColor="@color/secondary_text_color"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
