<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/earth_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/earth_background"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <ImageButton
                android:id="@+id/photo_grid_back"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/photo_grid_back"
                android:padding="8dp"
                android:src="@drawable/ic_back_nav" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/photo_grid_title"
                android:textColor="@color/primary_text_color"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/photo_grid_select_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/photo_grid_select_title"
                android:textColor="@color/primary_text_color"
                android:textSize="16sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/photo_grid_gallery"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="true"
                android:overScrollMode="never"
                android:padding="12dp" />

            <LinearLayout
                android:id="@+id/photo_grid_permission"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_photo_grid_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@string/photo_grid_permission"
                    android:src="@drawable/ic_area_measurement_warning"
                    android:tint="@color/home_accent" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/photo_grid_permission_title"
                    android:textColor="@color/primary_text_color"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/photo_grid_permission_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/poppins_regular"
                    android:gravity="center"
                    android:textColor="@color/secondary_text_color"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/photo_grid_permission_button"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/bg_area_measurement_button"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_photo_grid_selected"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/poppins_regular"
                    android:text="@string/photo_grid_selected"
                    android:textColor="@color/primary_text_color"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/photo_grid_selected_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/home_accent"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/photo_grid_create"
                style="@style/PhotoGridPrimaryButton"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:enabled="false"
                android:text="@string/photo_grid_create_grid"
                android:alpha="0.55" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/photo_grid_edit_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:visibility="gone">

            <com.gps.map.camera.and.time.stamp.ui.photogrid.PhotoGridPreviewView
                android:id="@+id/photo_grid_edit_preview"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="@color/white"
                android:clipToOutline="true" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/photo_grid_two_by_two"
                    style="@style/PhotoGridChip"
                    android:text="@string/photo_grid_two_by_two" />

                <TextView
                    android:id="@+id/photo_grid_vertical"
                    style="@style/PhotoGridChip"
                    android:layout_marginStart="8dp"
                    android:text="@string/photo_grid_vertical" />

                <TextView
                    android:id="@+id/photo_grid_horizontal"
                    style="@style/PhotoGridChip"
                    android:layout_marginStart="8dp"
                    android:text="@string/photo_grid_horizontal" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/photo_grid_spacing"
                style="@style/PhotoGridOptionRow"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/photo_grid_spacing"
                    android:textColor="@color/primary_text_color"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/photo_grid_spacing_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/home_accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/photo_grid_border"
                style="@style/PhotoGridOptionRow"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/photo_grid_border"
                    android:textColor="@color/primary_text_color"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/photo_grid_border_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:textColor="@color/home_accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/photo_grid_save"
                style="@style/PhotoGridPrimaryButton"
                android:layout_marginTop="8dp"
                android:text="@string/photo_grid_save_grid" />

            <TextView
                android:id="@+id/photo_grid_change_photos"
                style="@style/PhotoGridSecondaryButton"
                android:layout_marginTop="12dp"
                android:text="@string/photo_grid_change_photos" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/photo_grid_saved_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:visibility="gone">
            <com.gps.map.camera.and.time.stamp.ui.photogrid.PhotoGridPreviewView
                android:id="@+id/photo_grid_saved_preview"
                android:layout_width="match_parent"
                android:layout_height="320dp"
                android:background="@color/white"
                android:clipToOutline="true" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins_semibold"
                android:text="@string/photo_grid_saved"
                android:textColor="@color/primary_text_color"
                android:textSize="20sp" />
            <TextView
                android:id="@+id/photo_grid_open_gallery"
                style="@style/PhotoGridPrimaryButton"
                android:layout_marginTop="8dp"
                android:text="@string/photo_grid_open_gallery"
                />
            <TextView
                android:id="@+id/photo_grid_create_another"
                style="@style/PhotoGridSecondaryButton"
                android:layout_marginTop="12dp"
                android:text="@string/photo_grid_create_another" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/photo_grid_failed_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_photo_grid_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="20dp"
            android:visibility="gone">
            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/photo_grid_save_error"
                android:src="@drawable/ic_area_measurement_warning"
                android:tint="@color/home_accent" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/poppins_semibold"
                android:gravity="center"
                android:text="@string/photo_grid_failed_title"
                android:textColor="@color/primary_text_color"
                android:textSize="18sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center"
                android:text="@string/photo_grid_failed_message"
                android:textColor="@color/secondary_text_color"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/photo_grid_retry"
            style="@style/PhotoGridPrimaryButton"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:text="@string/photo_grid_retry_export"
            android:visibility="gone" />
        <TextView
            android:id="@+id/photo_grid_back_to_tools"
            style="@style/PhotoGridTextButton"
            android:layout_marginTop="12dp"
            android:text="@string/photo_grid_back_to_tools"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
