<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MyApplication" parent="android:Theme.Material.Light.NoActionBar" />

    <style name="UninstallReasonOption" parent="android:style/Widget.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:buttonTint">@color/uninstall_radio_tint</item>
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:textColor">@color/primary_text_color</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Theme.Main" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Window background -->
        <item name="android:windowBackground">#F4F4F4</item>
        <!-- Enable translucent status for edge-to-edge -->
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <!-- Disable fullscreen to show status bar -->
        <item name="android:windowFullscreen">false</item>
        <!-- No title bar -->
        <item name="android:windowNoTitle">true</item>
        <!-- Optional: Disable layout animations -->
        <item name="android:animateLayoutChanges">false</item>

        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Theme.Home" parent="Theme.Main">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:navigationBarColor">@color/home_navigation</item>
    </style>

    <style name="Theme.EarthView" parent="Theme.Main">
        <item name="android:windowBackground">@color/screen_background</item>
        <item name="android:statusBarColor">@color/screen_background</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="Theme.MapView" parent="Theme.EarthView">
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>
    </style>

    <style name="Theme.Splash" parent="Theme.Main">
