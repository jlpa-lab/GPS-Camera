<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base dark color (top-left & bottom-right stay dark) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0a1220" />
        </shape>
    </item>

    <!-- Top-right glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="1.0"
                android:centerY="0.0"
                android:gradientRadius="70%p"
                android:startColor="#99113469"
                android:centerColor="#40113469"
                android:endColor="#00113469" />
        </shape>
    </item>

    <!-- Bottom-left glow -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.0"
                android:centerY="1.0"
                android:gradientRadius="70%p"
                android:startColor="#99113469"
                android:centerColor="#40113469"
                android:endColor="#00113469" />
        </shape>
    </item>

</layer-list>